<!DOCTYPE html>


<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DuckLess</title>
<link href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Pixelify+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg1:#12072b;--bg2:#3b1670;--panel:#1f0f3d;--panel2:#2f1860;--line:#8b5cf6;--txt:#f5edff;--mut:#b9a6e6;--lime:#b8ff4f;--gold:#ffd23f;--pink:#ff5fa8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
*{box-sizing:inherit}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-weight:600;font-size:20px;color:var(--txt);background:linear-gradient(var(--bg1),var(--bg2) 60%,#6a2a8c) fixed}
canvas,img{image-rendering:pixelated;image-rendering:crisp-edges}
img.i{vertical-align:middle;display:inline-block}
h1,h2,.hd{font-family:'Silkscreen','Courier New',monospace;font-weight:700;margin:0}
.wrap{max-width:480px;margin:0 auto;padding:12px 14px 30px}
.logo{font-size:40px;color:#fff;text-shadow:3px 3px 0 #a855f7,6px 6px 0 #12072b;letter-spacing:1px}
.logo.sm{font-size:24px}
.btn{font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;font-weight:800;font-size:17px;color:var(--txt);background:var(--panel2);border:3px solid var(--line);padding:12px 14px;box-shadow:0 4px 0 #0009;cursor:pointer;margin:4px 6px 8px 0}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 #0009}
.btn.go{background:var(--lime);color:#12072b;border-color:#12072b}
.btn.big{width:100%;font-size:22px;padding:18px;margin:10px 0}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn[aria-pressed=true]{background:var(--gold);color:#12072b;border-color:#12072b}
:focus-visible{outline:3px solid var(--lime);outline-offset:2px}
.card{background:var(--panel);border:3px solid var(--line);box-shadow:0 5px 0 #0008;padding:14px;margin:14px 0}
.card p{margin:6px 0}
.top{display:flex;justify-content:space-between;align-items:center;gap:8px}
.pill{font-family:system-ui,Arial,sans-serif;font-weight:800;background:var(--panel2);border:3px solid var(--gold);color:var(--gold);padding:6px 10px;font-size:14px;display:inline-flex;align-items:center;gap:6px}
.tag{font-family:system-ui,Arial,sans-serif;font-weight:800;font-size:13px;background:var(--line);color:#fff;padding:3px 6px}
.own{background:linear-gradient(100deg,#ffd23f,#ff5fa8,#4fc3e8,#b8ff4f,#ffd23f)!important;background-size:250% 100%;animation:shine 2.5s linear infinite;color:#12072b!important;box-shadow:0 0 0 2px #12072b,0 0 10px #ffd23f;display:inline-flex;align-items:center;gap:4px;font-weight:700}
@keyframes shine{to{background-position:250% 0}}
.hero{text-align:center;margin-top:8px}
.stage{display:flex;justify-content:center;align-items:flex-end;height:190px;background:linear-gradient(#2b1160,#a63c8a 55%,#ff7a59);border:3px solid var(--line);padding-bottom:18px;position:relative;overflow:hidden}
.stage::after{content:"";position:absolute;left:0;right:0;bottom:0;height:20px;background:#e8c58a;border-top:4px solid #b8935a}
.stage canvas{position:relative;z-index:1;animation:bob 1.6s steps(2) infinite}
@keyframes bob{50%{transform:translateY(-4px)}}
.menu{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.menu .btn{margin:0;width:100%}
.items{display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:8px}
.item{font:inherit;font-size:19px;font-weight:700;color:var(--txt);background:var(--panel2);border:0;border-bottom:6px solid var(--rc,#999);box-shadow:0 0 0 3px #0008;padding:6px;cursor:pointer;text-align:center}
.item[aria-pressed=true]{background:#4a2a8c;box-shadow:0 0 0 3px var(--lime)}
.item small{display:block;color:var(--mut);font-size:14px}
.list .row2{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-bottom:2px dashed #ffffff22}
.list small{display:block;color:var(--mut)}
.row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px}
.hidden{display:none!important}
canvas[data-jf]{filter:drop-shadow(0 0 3px #ff2a1a)}
.rainbow canvas{animation:hue 2s linear infinite,bob 1.6s steps(2) infinite}
@keyframes hue{to{filter:hue-rotate(360deg)}}
input,select{font:inherit;font-size:20px;padding:8px;border:3px solid var(--line);background:#12072b;color:var(--txt);max-width:100%;margin:2px 0}
.code{font-family:'Silkscreen',monospace;font-size:34px;letter-spacing:8px;text-align:center;background:#12072b;color:var(--lime);border:3px dashed var(--lime);padding:12px}
#cv{display:block;width:100%;max-width:420px;margin:0 auto;border:3px solid var(--line);touch-action:none;background:#12072b}
#dash{display:block;width:100%;max-width:420px;margin:8px auto 0;font-size:18px;padding:16px;background:linear-gradient(90deg,var(--lime) var(--p,100%),var(--panel2) var(--p,100%));color:#12072b}
.chat{height:150px;overflow-y:auto;background:#12072b;border:3px solid var(--line);padding:6px;font-size:21px;margin:6px 0}
.chat div{margin:2px 0;word-break:break-word}
.crow{display:flex;gap:6px;align-items:center;font-size:21px;font-weight:700;margin:3px 0}
.crow i{display:inline-block;width:14px;height:14px}
.bar{height:14px;background:#12072b;margin:3px 0 8px;border:2px solid var(--line)}
.bar i{display:block;height:100%;background:var(--lime)}
#boot{position:fixed;inset:0;z-index:50;background:linear-gradient(#0d0520,#2b1160 45%,#a63c8a 75%,#ff7a59);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;transition:transform .7s steps(10);padding:20px;text-align:center;overflow:hidden}
#boot.gone{transform:translateY(-105%)}
#boot::before{content:"";position:absolute;top:8%;left:10%;width:4px;height:4px;background:#fff;box-shadow:60px 30px #fff,140px 10px #ffd,220px 50px #fff,300px 20px #fff,40px 90px #ffd,180px 100px #fff,260px 120px #fff,330px 80px #ffd,90px 150px #fff;animation:tw 2s steps(2) infinite}
@keyframes tw{50%{opacity:.4}}
#boot .logo{font-size:clamp(34px,11vw,56px)}
#bootDuck{animation:bob 1s steps(2) infinite;margin-top:6px}
.gr{display:flex;gap:4px}
.gr span{opacity:.15;animation:on .01s forwards}
@keyframes on{to{opacity:1}}
.wave{position:absolute;bottom:0;left:0;right:0;height:60px;background:repeating-linear-gradient(90deg,#1f6f8b 0 30px,#2a86a6 30px 60px);border-top:6px solid #4fc3e8;animation:slide 4s steps(8) infinite}
@keyframes slide{to{background-position:60px 0}}
.blink{animation:tw .8s steps(2) infinite}
#bc{position:fixed;left:8px;right:8px;top:calc(8px + env(safe-area-inset-top,0px));z-index:90;background:linear-gradient(100deg,#ffd23f,#ff9ec8,#ffd23f);background-size:250% 100%;animation:shine 2s linear infinite;color:#12072b;border:4px solid #12072b;box-shadow:0 6px 0 #0009;padding:14px;font-family:system-ui,Arial,sans-serif;font-size:21px;text-align:center;font-weight:800}
#boot:not(.gone)~#poll{display:none!important}
#poll{position:fixed;left:8px;right:8px;bottom:calc(8px + env(safe-area-inset-bottom,0px));max-width:464px;margin:0 auto;z-index:70;background:var(--panel);border:3px solid var(--lime);box-shadow:0 0 0 3px #000a;padding:12px}
#up{position:fixed;inset:0;z-index:80;background:#000b;display:flex;align-items:center;justify-content:center;padding:14px}
#up .card{width:100%;max-width:400px}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:#12072b;border:3px solid var(--lime);color:#fff;padding:10px 14px;z-index:99;max-width:90vw;text-align:center}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01s!important}}
#fx{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:95}
#cr{position:fixed;inset:0;z-index:96;background:#000d;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:14px;text-align:center}
#cr .win{position:relative;width:100%;max-width:420px;height:118px;overflow:hidden;border:3px solid #ffd23f;background:#12072b}
#cr .win::after{content:"";position:absolute;left:50%;top:0;bottom:0;width:4px;margin-left:-2px;background:#b8ff4f;box-shadow:0 0 12px #b8ff4f}
#cr .strip{display:flex;height:100%;will-change:transform}
#cr .cell{flex:0 0 84px;display:flex;align-items:center;justify-content:center;border-bottom:6px solid var(--rc);background:#2f1860}
@keyframes shk{0%,100%{transform:none}20%{transform:translate(-6px,3px)}40%{transform:translate(5px,-4px)}60%{transform:translate(-4px,-3px)}80%{transform:translate(4px,4px)}}
.shake{animation:shk .5s 3}
@keyframes pop{0%{transform:scale(.2);opacity:0}60%{transform:scale(1.25)}100%{transform:scale(1);opacity:1}}
.pop{animation:pop .5s}
body{font-size:22px}
.pill{font-size:21px;padding:8px 12px;background:#12072b;color:#fff;text-shadow:2px 2px 0 #000;box-shadow:0 3px 0 #0009}
.pill .cn,.pill .fn{font-size:34px;font-weight:800;color:#ffe56a;min-width:1ch;font-variant-numeric:tabular-nums;letter-spacing:1px}
.item small{font-size:19px;font-weight:700;color:#fff;margin-top:3px;text-shadow:1px 1px 0 #000}
.list small,.card small{color:#f4eeff;font-size:19px;font-weight:600}
.item.sec{background:#000;box-shadow:0 0 0 3px #fff}
.wbtn{position:static;flex:none;width:52px;height:52px;padding:0;border:0;background:none;cursor:pointer;filter:drop-shadow(0 3px 0 #0009)}
.wbtn canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
.wbtn.spin canvas{animation:wsp .7s steps(8) 1}
@keyframes wsp{to{transform:rotate(360deg)}}
.bga{background-size:300% 100%!important;animation:rbs 4s linear infinite}
.rbbg{background:linear-gradient(135deg,#ffb3c9,#ffe0a3,#fff7b0,#b8f5c8,#aee3ff,#d4b8ff,#ffb3c9)!important;background-size:200% 200%!important;animation:rbs2 6s ease-in-out infinite;position:relative;overflow:hidden}
.rbbg::before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 36%,#ffffffaa 46%,#fff 50%,#ffffffaa 54%,transparent 64%);background-size:250% 100%;animation:glint 2.4s linear infinite;pointer-events:none;z-index:0}
.item.rbbg{isolation:isolate}
.item.rbbg::before{z-index:-1}
.item.rbbg,.item.rbbg small{color:#000;text-shadow:none}
.item.rbbg[aria-pressed=true]{animation:rbs2 6s ease-in-out infinite,rbring 1.6s linear infinite}
.stage.rbbg{animation:rbs2 6s ease-in-out infinite,rbbd 1.6s linear infinite}
@keyframes rbring{0%,100%{box-shadow:0 0 0 4px #ff3b3b,0 0 14px 4px #ff3b3b}17%{box-shadow:0 0 0 4px #ffe14a,0 0 14px 4px #ffe14a}33%{box-shadow:0 0 0 4px #5fe05a,0 0 14px 4px #5fe05a}50%{box-shadow:0 0 0 4px #2fd8ff,0 0 14px 4px #2fd8ff}67%{box-shadow:0 0 0 4px #4a6bff,0 0 14px 4px #4a6bff}83%{box-shadow:0 0 0 4px #c44aff,0 0 14px 4px #c44aff}}
@keyframes rbbd{0%,100%{border-color:#ff3b3b}17%{border-color:#ffe14a}33%{border-color:#5fe05a}50%{border-color:#2fd8ff}67%{border-color:#4a6bff}83%{border-color:#c44aff}}
@keyframes rbs2{0%,100%{background-position:0 0}50%{background-position:100% 100%}}
@keyframes glint{from{background-position:150% 0}to{background-position:-100% 0}}
@keyframes rbs{to{background-position:300% 0}}
#wc{display:block;width:100%;max-width:400px;margin:6px auto;image-rendering:pixelated}
#wMsg{font-size:24px;color:var(--gold);min-height:34px;margin:8px 0}
#amb{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:97}
#evb{position:fixed;left:14px;top:calc(54px + env(safe-area-inset-top,0px));z-index:60;pointer-events:none;font-family:system-ui,Arial,sans-serif;font-weight:800;font-size:18px;line-height:1.4;background:#12072bee;border:3px solid var(--gold);color:var(--gold);padding:4px 8px;box-shadow:0 3px 0 #0009}
#cmdOut{height:110px;font-size:20px;font-weight:700;font-family:ui-monospace,Menlo,Consolas,monospace}
.cl-in{color:var(--lime)}.cl-out{color:#fff}.cl-err{color:var(--pink)}
.cmdrow{display:flex;gap:6px;align-items:center}
.cmdrow input{flex:1;min-width:0;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:21px}
#cmdHelp{max-height:420px;overflow-y:auto;margin-top:8px;border:3px solid var(--line);padding:4px 8px;background:#12072b}
#cmdHelp .row2{cursor:pointer}
#cmdHelp .row2:hover{background:#ffffff14}
#cmdHelp small{word-break:break-word}
.sg{font-size:22px;color:#fff;word-break:break-word}
#cmdHelp .row2{padding:10px 0}
.bignum{font-family:system-ui,Arial,sans-serif;font-size:48px;font-weight:800;color:var(--gold);text-shadow:2px 2px 0 #000;font-variant-numeric:tabular-nums}
#eg{position:fixed;inset:0;z-index:85;background:#000c;display:flex;align-items:center;justify-content:center;padding:12px;overflow-y:auto}
#eg .card{width:100%;max-width:440px;text-align:center;margin:0}
#eg p{font-size:21px;font-weight:600}
.egrow{display:flex;gap:10px;justify-content:space-around;align-items:center;font-size:22px;font-weight:700}
.egrow b{font-size:36px;color:var(--gold);text-shadow:2px 2px 0 #000;font-variant-numeric:tabular-nums}
.egarea{position:relative;height:300px;margin:8px 0;background:linear-gradient(#2b1160,#a63c8a);border:3px solid var(--line);overflow:hidden;touch-action:manipulation}
.egt{position:absolute;background:none;border:0;padding:0;cursor:pointer;width:72px;height:72px;display:flex;align-items:center;justify-content:center}
.egbar{position:relative;height:44px;background:#12072b;border:3px solid var(--line);margin:14px 0}
.egbar i{position:absolute;top:0;bottom:0;background:#3fbf5a}
.egbar b{position:absolute;top:-6px;bottom:-6px;width:6px;margin-left:-3px;background:#fff;font-size:0}
#egb{position:fixed;left:0;right:0;margin:0 auto;width:92%;max-width:440px;bottom:calc(76px + env(safe-area-inset-bottom,0px));z-index:65;font-size:19px;background:linear-gradient(100deg,#b8ff4f,#ffd23f,#b8ff4f);background-size:250% 100%;animation:shine 2s linear infinite}
.t-burger{--bg1:#7a1a0a;--bg2:#e0652a;--panel:#8a2610;--panel2:#c8431a;--line:#ffd23f;--mut:#ffe0a0;--lime:#ffe14a}
.t-burger body{background:repeating-conic-gradient(#d62a1a 0 25%,#fff3d6 0 50%) 0 0/48px 48px fixed}
.t-burger .logo{color:#ffe14a;text-shadow:3px 3px 0 #d62a1a,6px 6px 0 #5a1000}
.t-burger .stage{background:linear-gradient(#ff9a3d,#ffd23f 60%,#e8a43a)}
.t-burger .btn.go{background:#ffe14a;color:#5a1000}
@keyframes glt{0%,100%{transform:none;filter:none}10%{transform:translate(-5px,2px) skewX(3deg);filter:hue-rotate(90deg) saturate(3)}20%{transform:translate(6px,-2px);filter:invert(1)}35%{transform:none;filter:none}50%{transform:translate(-3px,0) skewX(-4deg);filter:hue-rotate(200deg) contrast(1.6)}60%{transform:none;filter:none}75%{transform:translate(4px,3px);filter:invert(1) hue-rotate(90deg)}85%{transform:none;filter:none}}
@keyframes inv{0%,100%{filter:invert(1) hue-rotate(0deg)}50%{filter:invert(1) hue-rotate(180deg)}}
@keyframes wob{0%,100%{transform:rotate(-1.8deg) scale(1.01)}50%{transform:rotate(1.8deg) scale(1.01)}}

#admin summary{cursor:pointer;color:var(--gold);padding:8px 0;font-size:14px;font-weight:700}
#admin{background:#1a0e33;border-radius:14px}
.cmdrow input{font-size:16px!important;padding:10px 12px!important;border-radius:10px}
#adQuick{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
#adQuick .btn{font-size:12.5px!important;padding:6px 12px!important;margin:0!important;border-radius:99px;background:#ffffff12;border:1px solid #ffffff30!important;box-shadow:none!important;color:#fff}
#adQuick .btn:hover{background:#ffffff24}
#cmdOut{height:130px!important;font-size:13px!important;font-weight:600!important;background:#0b0418;border:1px solid #ffffff22!important;border-radius:10px;padding:8px 10px;overflow-y:auto;line-height:1.5}
#cmdHelp{max-height:380px!important;border:1px solid #ffffff22!important;border-radius:10px;padding:0 6px!important;background:#0b0418!important}
#cmdHelp .row2{padding:7px 6px!important;border-bottom:1px solid #ffffff12!important}
#cmdHelp .sg{font-size:13.5px!important;color:#b8ff4f;font-family:ui-monospace,Menlo,Consolas,monospace}
#cmdHelp small{display:block;font-size:11.5px;color:#ffffffa0;margin-top:2px;line-height:1.35}
.adh{position:sticky;top:0;background:#0b0418;z-index:1;margin:0!important;padding:10px 6px 4px;font-size:11px!important;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);border-bottom:1px solid #ffffff1f}
.mtile{background:var(--panel);border:3px solid var(--mc);border-left-width:14px;box-shadow:0 5px 0 #000a,0 0 16px -2px var(--mc);padding:10px 12px;margin:14px 0}
.mtile b{font-family:'Silkscreen',monospace;font-size:21px;color:var(--mc)}.mtile .gn{background:var(--mc);color:#12072b;font-size:15px;font-weight:800;padding:2px 8px}
.mtile small{margin:6px 0 8px}.mtile .btn{margin:0;color:#12072b;border-color:#12072b}
#mg{--mc:#8b5cf6}#mgName{color:var(--mc)}#mgHud{white-space:pre}
#mgArea{position:relative;height:400px;max-width:420px;margin:8px auto;border:3px solid var(--mc);background:#12072b;overflow:hidden;touch-action:manipulation;user-select:none}
#mgArea.mgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:8px}#mgArea.g3{grid-template-columns:repeat(3,1fr)}#mgArea.g2{grid-template-columns:1fr 1fr}
.mgo{display:block;width:calc(100% - 20px);margin:8px 10px;font-size:22px}
.board{background:#1d5a3a;border:6px solid #8a5a2b;margin:10px;padding:18px 8px;text-align:center;color:#fff}.board h3{margin:0;font-size:26px}
.card2{background:var(--panel2);border:3px solid var(--line);cursor:pointer;padding:0}.card2.up{background:#fff}
.mgi{position:absolute;background:none;border:0;padding:6px;cursor:pointer}
.dark{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle 90px at var(--x,50%) var(--y,50%),transparent 55%,#050014 100%)}
.hole{background:#3a2a14;border:3px solid #8a5a2b;border-radius:50%;cursor:pointer}
.tbar{position:relative;height:54px;margin:120px 14px 30px;background:#2c1a55;border:3px solid var(--line)}.tbar i{position:absolute;top:0;bottom:0;background:#ffc400}.tbar b{position:absolute;top:-8px;bottom:-8px;width:6px;margin-left:-3px;background:#fff}
.pad{border:4px solid #12072b;cursor:pointer;opacity:.55}.pad.lit{opacity:1;filter:brightness(1.5)}
.rx{position:absolute;inset:0;width:100%;border:0;font:800 36px system-ui,sans-serif;color:#fff;cursor:pointer}
.bub{position:absolute;bottom:-76px;width:70px;height:70px;padding:0;background:#ffffff22;border:2px solid #fff6;border-radius:50%;cursor:pointer;animation:rise 2.4s linear forwards}
@keyframes rise{to{transform:translateY(-490px)}}
#menu{position:fixed;inset:0;z-index:80;background:#000b;display:flex;align-items:center;justify-content:center;padding:14px}#menu .card{width:100%;max-width:400px;margin:0}
#cheer .btn{font-size:15px;padding:6px 10px;margin:6px 6px 0 0}

/* nicer grapes counter, menu bars, cleaner shop */
.pill{display:inline-flex;align-items:center;gap:8px;padding:4px 16px 4px 5px;border-radius:999px;background:linear-gradient(#2d165f,#170a33);border:2px solid var(--gold);box-shadow:0 3px 0 #0009,inset 0 0 14px #8b5cf655,0 0 14px #ffd23f33;color:#fff;text-shadow:none}
.pill .gi,.pill .fi{display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#7a4ad0,#3a1a7a);border:2px solid #b794ff;flex:none}
.pill .cn,.pill .fn{font-size:26px;font-weight:800;color:#ffe56a;letter-spacing:.5px;text-shadow:0 2px 0 #0008;min-width:1ch}
.pill.tick{animation:tickp .45s}
@keyframes tickp{30%{transform:scale(1.12);box-shadow:0 3px 0 #0009,0 0 22px #ffd23f}}
#mgHud{font-size:20px;padding:6px 14px;gap:0;border-radius:12px}
#goMenu{width:52px;height:52px;margin:0;padding:0;display:flex;align-items:center;justify-content:center}
.bars{display:flex;flex-direction:column;gap:5px;width:24px}.bars i{display:block;height:4px;background:currentColor}
#shop .card{box-shadow:none;border-width:2px;border-radius:10px;padding:12px;margin:10px 0}
#shop .stage{height:150px}
#tabs{display:flex;gap:6px;overflow-x:auto;margin:12px 0 2px;padding-bottom:4px}
#tabs .tab{flex:none;margin:0;padding:8px 14px;font-size:15px;box-shadow:none;border-width:2px;border-radius:999px;background:transparent}
#tabs .tab[aria-pressed=true]{background:var(--gold);color:#12072b}
